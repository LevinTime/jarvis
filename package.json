{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "jarvis": "tsx src/cli.ts",
    "bot": "tsx src/bot/index.ts",
    "web": "tsx src/web/index.ts",
    "start": "tsx scripts/ensure-web-build.ts && tsx src/main.ts",
    "web:dev": "vite --config web/vite.config.ts --host 127.0.0.1 --port 5173",
    "web:build": "tsx scripts/write-icons.ts && vite build --config web/vite.config.ts",
    "dev": "concurrently -n api,web \"tsx watch src/main.ts\" \"npm run web:dev\"",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "grammy": "^1.46.0",
    "hono": "^4.13.13",
    "openai": "^7.36.0"
  }
}
