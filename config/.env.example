GROK_API_KEY=
GROK_MODEL=grok-4.3
# Denk-Aufwand: none, minimal, low, medium, high, xhigh, max. Standard none, das spart Tokens.
GROK_REASONING_EFFORT=none
# Obergrenze für eine Antwort. Standard 500.
GROK_MAX_TOKENS=500
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=
TZ=Europe/Berlin
JARVIS_WEB_PORT=3000
# Monatsbudget in US-Dollar. Standard 15, wenn die Zeile fehlt.
# Ab 80 Prozent Warnung, ab 100 Prozent Hinweis in App und Telegram. Antworten werden nicht blockiert.
# 0 schaltet das Budget aus.
JARVIS_MONTHLY_BUDGET_USD=15
# Optional. Tailscale-Login, zum Beispiel der Name aus `tailscale status`.
# Wenn gesetzt, muss der Header Tailscale-User-Login exakt passen.
# Requests vom eigenen PC ohne diesen Header bleiben erlaubt.
# Das gilt nur, weil der Server ausschließlich auf 127.0.0.1 lauscht und von außen nur über tailscale serve erreichbar ist.
# JARVIS_ALLOWED_TS_USER=
# T3 Code im Handy. Standard https://levin.tail34013b.ts.net:8443. In der App überschreibbar.
# Nur die Basisadresse, keine Pairing-Tokens und keine Zugangsdaten.
JARVIS_T3_URL=https://levin.tail34013b.ts.net:8443
OLLAMA_URL=http://localhost:11434
WEATHER_LOCATION=Issum
# Gedächtnis und Korrekturen liegen in data/memory.json, data/memory.md und data/corrections.json.
# Dafür gibt es keine eigene Variable und kein Secret.
