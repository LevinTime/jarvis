GROK_API_KEY=
GROK_MODEL=grok-4
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=
TZ=Europe/Berlin
JARVIS_WEB_PORT=3000
# Optionales Monatsbudget in US-Dollar. Ab 80 Prozent und ab 100 Prozent warnt die App. Leer = kein Budget.
# JARVIS_MONTHLY_BUDGET_USD=
# Optional. Tailscale-Login, zum Beispiel der Name aus `tailscale status`.
# Wenn gesetzt, muss der Header Tailscale-User-Login exakt passen.
# Requests vom eigenen PC ohne diesen Header bleiben erlaubt.
# Das gilt nur, weil der Server ausschließlich auf 127.0.0.1 lauscht und von außen nur über tailscale serve erreichbar ist.
# JARVIS_ALLOWED_TS_USER=
OLLAMA_URL=http://localhost:11434
WEATHER_LOCATION=Issum
